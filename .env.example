# --- Database (libSQL / Turso) ---
# Dev: `bun dev:db` runs a local libSQL server backed by ./data/dev.db
DATABASE_URL=http://127.0.0.1:8080
# Prod Turso: DATABASE_URL=libsql://<db>-<org>.turso.io and set a token
DATABASE_AUTH_TOKEN=

# 32-byte key, base64. Generate: openssl rand -base64 32
# Encrypts platform stream keys at rest. Web and relay MUST share it.
ENCRYPTION_KEY=

# Shared secret between MediaMTX auth hook and the relay (relay reads streams with it)
RELAY_SECRET=

# Web app secret (seals session cookies). Generate: openssl rand -base64 32
NUXT_APP_SECRET=

# Public hostname Caddy serves (HTTPS) — VPS deploy
DOMAIN=stream.discerns.app

# Shown in the dashboard as the OBS server URL
NUXT_PUBLIC_INGEST_URL=rtmp://stream.discerns.app:1935/live

# Relay → MediaMTX (internal)
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_RTMP_URL=rtmp://127.0.0.1:1935

# Public URL of the dashboard (OAuth callbacks, OBS plugin sign-in page)
NUXT_PUBLIC_SITE_URL=https://stream.discerns.app

# "Connect with …" developer apps. See docs/connect-apps.md.
# Callback URLs: <NUXT_PUBLIC_SITE_URL>/api/connect/{youtube,twitch,kick}/callback
NUXT_CONNECT_YOUTUBE_CLIENT_ID=
NUXT_CONNECT_YOUTUBE_CLIENT_SECRET=
NUXT_CONNECT_TWITCH_CLIENT_ID=
NUXT_CONNECT_TWITCH_CLIENT_SECRET=
NUXT_CONNECT_KICK_CLIENT_ID=
NUXT_CONNECT_KICK_CLIENT_SECRET=
