# HTTPS is automatic: Caddy gets and renews a Let's Encrypt certificate for
# $DOMAIN, as long as DNS points here and ports 80/443 are open.
{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Relay → web only (also secret-protected); never from the internet.
	handle /api/internal/* {
		respond 404
	}

	# Merged chat stream (OBS plugin, overlays, dashboard) → relay.
	# Not compressed: compression would buffer the live event stream.
	handle /chat/* {
		reverse_proxy relay:8787 {
			flush_interval -1
		}
	}

	# Browser streaming (WebRTC WHIP) → MediaMTX
	handle_path /whip/* {
		reverse_proxy mediamtx:8889
	}

	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}
}
